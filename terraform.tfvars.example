# AWS Configuration
aws_region   = "eu-central-1"
prefix_name  = "dev"

# Networking
networking_enabled   = true
vpc_id               = "vpc-xxxxx"
db_subnet_group_name = "your-db-subnet-group"
security_group_names = ["your-security-group-1", "your-security-group-2"]

# RDS Instance Configuration
db_instance_enabled            = true
rds_engine_version             = "15.00.4198.2.v1"
db_instance_class              = "db.t3.medium"
db_allocated_storage           = 100
db_instance_storage_type       = "gp3" # Options: standard, gp2, gp3, io1, io2
db_instance_storage_throughput = 300  # Required for gp3: 125-1000 MB/s (recommended: 300+)
db_instance_iops               = null  # Optional for gp3: 3000-16000, Required for io1/io2: 1000-64000
db_username                    = "admin"
db_password                    = "your-secure-password"
db_apply_immediately           = true
db_allow_major_version_upgrade = true
db_auto_minor_version_upgrade  = true
db_skip_final_snapshot         = false
license_model                  = "license-included"

# Alternative Storage Configurations (choose one):

# GP2 (Legacy, included in storage cost)
# db_instance_storage_type       = "gp2"
# db_instance_storage_throughput = null
# db_instance_iops               = null

# GP3 High Performance
# db_instance_storage_type       = "gp3"
# db_instance_storage_throughput = 500
# db_instance_iops               = 5000

# IO1 High IOPS
# db_instance_storage_type       = "io1"
# db_instance_storage_throughput = null
# db_instance_iops               = 10000

# Domain Integration (SQL Server EE / Windows Authentication via AWS Directory Service)
domain               = "corp.example.com"
domain_iam_role_name = "rds-ad-domain-join-role"

# Rollback Configuration
rollback_enabled                   = false
rollback_snapshot_identifier       = "rds:mydb-2024-03-18-14-30"
rollback_stop_source_instance      = true
rollback_identifier                = "mydb-rollback"
rollback_instance_class            = "db.t3.medium"
rollback_skip_final_snapshot       = false
rollback_final_snapshot_identifier = "mydb-rollback-final-snapshot"
rollback_apply_immediately         = true
